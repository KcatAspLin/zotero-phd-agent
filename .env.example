# Personal library: numeric user ID displayed at https://www.zotero.org/settings/keys
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
# Grant library read/write and file access. Never paste keys into chat.
ZOTERO_API_KEY=
# Choose openai (default) or ollama (local, no OpenAI key required).
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Must support Responses API + Structured Outputs.
OPENAI_MODEL=gpt-5-mini
# Used only with LLM_PROVIDER=ollama. Download first: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=32768
# Optional, used for polite DOI metadata requests.
CROSSREF_EMAIL=
# Optional: pin an existing PhD collection when its name is ambiguous.
ZOTERO_PHD_COLLECTION_KEY=
