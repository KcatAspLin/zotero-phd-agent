# Personal library: numeric user ID displayed at https://www.zotero.org/settings/keys
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
# Grant library read/write and file access. Never paste keys into chat.
ZOTERO_API_KEY=
OPENAI_API_KEY=
# Must support Responses API + Structured Outputs.
OPENAI_MODEL=gpt-5-mini
# Optional, used for polite DOI metadata requests.
CROSSREF_EMAIL=
# Optional: pin an existing PhD collection when its name is ambiguous.
ZOTERO_PHD_COLLECTION_KEY=
